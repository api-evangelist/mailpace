          "request": {
            "name": "Send a transactional email",
            "description": {
              "content": "Sends a single transactional email. Authenticated with the MailPace-Server-Token header. One of htmlbody or textbody is required. Up to 50 recipients are allowed across the to field, and the total message size may not exceed 50 MB.",
